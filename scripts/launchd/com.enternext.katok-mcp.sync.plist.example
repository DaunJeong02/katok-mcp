<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template: every 30 minutes, sync new KakaoTalk messages, save the attachments
  (files, photos, videos) whose download link is still valid, then update the semantic index.
  Attachment links expire, so a regular backfill is how files get kept. This file is only a
  template; nothing installs it.

  The index step runs `katok index`. The first index embeds every window and can take tens of
  minutes (about 90 minutes for 14k windows). Later runs are incremental and short, because
  unchanged windows reuse their vectors. If `katok index` fails with `semantic_index_busy`,
  another index is already running; the failure is recorded and the next run tries again.

  Install (see README.md, "30분마다 자동 동기화"):
    1. Replace __REPO__ with the absolute path of this repository, __HOME__ with your home and
       __DATA_DIR__ with the data folder (default: __HOME__/Library/Application Support/katok-mcp).
    2. In EnvironmentVariables below, put the SAME values as in your MCP registration:
       KATOK_MCP_DATA_DIR (= KATOK_MCP_DATA_DIR of the MCP server, or its default data folder)
       and the Keychain service / account (= KATOK_MCP_KEYCHAIN_SERVICE / _ACCOUNT, or the
       defaults). If they differ, this job reads another archive or another key than the server.
    3. Save as ~/Library/LaunchAgents/com.enternext.katok-mcp.sync.plist
    4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.enternext.katok-mcp.sync.plist
  Remove:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.enternext.katok-mcp.sync.plist

  Full Disk Access is NOT inherited from your terminal: grant it to /bin/bash and to
  __REPO__/cli/target/release/katok. Run katok_init once first, so the Keychain key exists.
  The binary is ad-hoc signed, so every rebuild changes its code hash (cdhash) and can void that
  macOS approval. After a rebuild, approve cli/target/release/katok again in System Settings >
  Privacy & Security > Full Disk Access. Do not build the release binary (cargo build, release profile) while
  this job is running; check with: launchctl print gui/$(id -u)/com.enternext.katok-mcp.sync | grep state

  Where the output goes:
    - stdout of each step (katok's JSON result, counts and status, no message text) is saved,
      overwritten on every run, to $KATOK_MCP_DATA_DIR/last-sync.json (sync),
      last-backfill.json (media backfill) and last-index.json (index). The folder is made 0700
      and the files 0600. A failing step prints its error envelope on stdout too, so the
      failure is in that file. All three files are deleted at the start of a run, so a missing file means that step did not run
      or did not finish (the log says why).
    - stderr goes to the log below, plus one "failed" line with the exit code and time when the
      job stops. The log is never rotated; truncate it now and then.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.enternext.katok-mcp.sync</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>KATOK_MCP_DATA_DIR</key>
    <string>__DATA_DIR__</string>
    <key>KATOK_MCP_KEYCHAIN_SERVICE</key>
    <string>com.enternext.katok-mcp</string>
    <key>KATOK_MCP_KEYCHAIN_ACCOUNT</key>
    <string>archive-key</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -eu
umask 077
BIN="__REPO__/cli/target/release/katok"
DATA="${KATOK_MCP_DATA_DIR:?KATOK_MCP_DATA_DIR is not set}"
SERVICE="${KATOK_MCP_KEYCHAIN_SERVICE:?}"
ACCOUNT="${KATOK_MCP_KEYCHAIN_ACCOUNT:?}"
trap 'echo "katok-mcp sync failed (exit $?) at $(date -u +%FT%TZ); see the log and $DATA/last-*.json" &gt;&amp;2' ERR
mkdir -p "$DATA"
chmod 700 "$DATA"
rm -f "$DATA/last-sync.json" "$DATA/last-backfill.json" "$DATA/last-index.json"
KATOK_ARCHIVE_KEY="$(/usr/bin/security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w)"
export KATOK_ARCHIVE_KEY
"$BIN" --data-dir "$DATA" sync --source macos --incremental --json &gt;"$DATA/last-sync.json"
"$BIN" --data-dir "$DATA" media backfill --kind file --kind photo --kind video --out "$DATA/media" --json &gt;"$DATA/last-backfill.json"
"$BIN" --data-dir "$DATA" index --json &gt;"$DATA/last-index.json"</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/katok-mcp-sync.log</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
</dict>
</plist>
